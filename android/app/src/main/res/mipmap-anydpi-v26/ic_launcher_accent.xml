<?xml version="1.0" encoding="utf-8"?>
<!-- "Tricolor" variant: the exact default grid in three colour bands
     (red / green / blue, top to bottom), same dark bg. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
      <inset
          android:drawable="@mipmap/ic_launcher_fg_tri"
          android:inset="16%" />
  </foreground>
  <monochrome>
      <inset
          android:drawable="@mipmap/ic_launcher_monochrome"
          android:inset="16%" />
  </monochrome>
</adaptive-icon>
