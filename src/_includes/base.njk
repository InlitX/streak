{% from "t.njk" import t %}<!doctype html>
<html lang="{{ lang or 'en' }}" data-lang="{{ lang or 'en' }}"{% if lang %} data-fixed="{{ lang }}"{% endif %}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% if title %}{{ title }} · Streak{% else %}Streak · A quiet habit tracker{% endif %}</title>
  <meta name="description" content="{{ description or 'An open-source habit tracker for Android, Windows and Linux. One tap a day, a year at a glance, a focus timer. No account, no internet, no ads.' }}" />
  <meta name="theme-color" content="#09090B" />
  <meta property="og:title" content="{{ title or 'Streak' }}" />
  <meta property="og:description" content="{{ description or 'One tap a day. Watch the year fill in.' }}" />
  <meta property="og:type" content="{{ 'article' if lang else 'website' }}" />
  <meta property="og:image" content="{{ site.url }}/assets/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/assets/icon.png" />
  <link rel="alternate" type="application/atom+xml" title="Streak blog" href="/blog/feed.xml" />
  <script>
    (function () {
      var root = document.documentElement;
      var lang = root.dataset.fixed;
      if (!lang) {
        try { lang = localStorage.getItem('streak-lang'); } catch (e) {}
        if (!lang) lang = (navigator.language || '').slice(0, 2).toLowerCase();
      }
      root.dataset.lang = lang === 'es' ? 'es' : 'en';
      root.lang = root.dataset.lang;
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css?v={{ 'css/styles.css' | v }}" />
</head>
<body class="page-{{ page_kind or 'home' }}">
  <header class="bar">
    <div class="bar__in">
      <a class="brand" href="/">
        <img src="/assets/icon.svg" width="24" height="24" alt="" />
        <span>Streak</span>
      </a>
      <nav class="nav">
        <a href="/#download"{% if page_kind == 'home' %} data-local{% endif %}>{{ t('Download', 'Descargar') }}</a>
        <a href="/blog/"{% if page_kind == 'blog' %} aria-current="page"{% endif %}>Blog</a>
        <a href="/resources/"{% if page_kind == 'resources' %} aria-current="page"{% endif %}>{{ t('Resources', 'Recursos') }}</a>
        <a class="nav__love" href="/#support"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.3 4.3 12.8a4.6 4.6 0 0 1 6.5-6.5l1.2 1.2 1.2-1.2a4.6 4.6 0 0 1 6.5 6.5Z"/></svg>{{ t('Support', 'Apoyar') }}</a>
      </nav>
      <div class="bar__end">
        <button class="lang" id="lang" type="button" aria-label="Switch language">
          <span data-l="en">EN</span><span data-l="es">ES</span>
        </button>
        <a class="stars" href="{{ site.repo }}" target="_blank" rel="noopener" aria-label="Streak on GitHub">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.2-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.75.81 1.2 1.84 1.2 3.1 0 4.43-2.7 5.4-5.28 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
          <svg class="stars__star" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 2.4l2.95 5.98 6.6.96-4.78 4.65 1.13 6.57L12 17.46l-5.9 3.1 1.13-6.57L2.45 9.34l6.6-.96L12 2.4Z"/></svg>
          <span data-count="stars">—</span>
        </a>
      </div>
    </div>
  </header>

  <main>
{{ content | safe }}
  </main>

  <footer class="foot">
    <div class="foot__in">
      <a class="brand" href="/">
        <img src="/assets/icon.svg" width="20" height="20" alt="" />
        <span>Streak</span>
      </a>
      <nav class="foot__nav">
        <a href="{{ site.repo }}" target="_blank" rel="noopener">GitHub</a>
        <a href="/blog/">Blog</a>
        <a href="/resources/">{{ t('Resources', 'Recursos') }}</a>
        <a href="{{ site.weblate }}" target="_blank" rel="noopener">{{ t('Translate', 'Traducir') }}</a>
        <a href="{{ site.repo }}/issues" target="_blank" rel="noopener">{{ t('Report a bug', 'Reportar un fallo') }}</a>
        <a href="{{ site.kofi }}" target="_blank" rel="noopener">Ko-fi</a>
      </nav>
      <p class="foot__c">
        <a href="{{ site.repo }}/blob/main/LICENSE" target="_blank" rel="noopener">GPLv3</a>
        · {{ t('Made by', 'Hecha por') }} <a href="https://github.com/InlitX" target="_blank" rel="noopener">InlitX</a>
      </p>
    </div>
  </footer>

  <dialog class="lb" id="lb" aria-label="Preview">
    <button class="lb__x" type="button" data-lb="close" aria-label="Close"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    <button class="lb__nav lb__nav--prev" type="button" data-lb="-1" aria-label="Previous"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
    <div class="lb__stage"></div>
    <button class="lb__nav lb__nav--next" type="button" data-lb="1" aria-label="Next"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
    <p class="lb__cap"></p>
  </dialog>

  <script src="/js/site.js?v={{ 'js/site.js' | v }}"></script>
</body>
</html>
